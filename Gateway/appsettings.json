{
  "GatewayAuth": {
    "UserName": "orderflow-admin",
    "Password": "orderflow-dev-password"
  },
  "ReverseProxy": {
    "Routes": {
      "customers": { "ClusterId": "customers", "Match": { "Path": "/api/customers/{**catch-all}" } },
      "products": { "ClusterId": "products", "Match": { "Path": "/api/products/{**catch-all}" } },
      "inventory": { "ClusterId": "inventory", "Match": { "Path": "/api/inventory/{**catch-all}" } },
      "orders": { "ClusterId": "orders", "Match": { "Path": "/api/orders/{**catch-all}" } },
      "checkout": { "ClusterId": "orders", "Match": { "Path": "/api/checkout/{**catch-all}" } },
      "payments": { "ClusterId": "payments", "Match": { "Path": "/api/payments/{**catch-all}" } },
      "notifications": { "ClusterId": "notifications", "Match": { "Path": "/api/notifications/{**catch-all}" } },
      "ai": { "ClusterId": "ai", "Match": { "Path": "/api/ai/{**catch-all}" } }
    },
    "Clusters": {
      "customers": { "Destinations": { "default": { "Address": "http://localhost:6101/" } } },
      "products": { "Destinations": { "default": { "Address": "http://localhost:6102/" } } },
      "inventory": { "Destinations": { "default": { "Address": "http://localhost:6103/" } } },
      "orders": { "Destinations": { "default": { "Address": "http://localhost:6104/" } } },
      "payments": { "Destinations": { "default": { "Address": "http://localhost:6105/" } } },
      "notifications": { "Destinations": { "default": { "Address": "http://localhost:6106/" } } },
      "ai": { "Destinations": { "default": { "Address": "http://localhost:6107/" } } }
    }
  },
  "AllowedHosts": "*"
}
